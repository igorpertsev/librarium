# Copy to .env (git-ignored). Read by Vite (VITE_*) and by docker compose (the rest).

# --- Frontend -------------------------------------------------------------------------
# Base URL of the API including the version prefix. Must be same-site with the frontend
# (e.g. both on localhost) for the SameSite=Lax refresh cookie to be sent.
VITE_API_URL=http://localhost:8000/api/v1

# --- docker compose ---------------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=bookstore
# Host port of PostgreSQL (5433 avoids a clash with a local PostgreSQL on 5432).
POSTGRES_PORT=5433
BACKEND_PORT=8000

ENVIRONMENT=development
# Empty in development => ephemeral random secret (sessions die on restart).
# Required (>= 32 random chars) in production.
JWT_SECRET_KEY=
# Optional: keys for the two-step sign-in secrets, comma-separated, the encrypting one first
# (>= 32 random chars each). Empty => derived from JWT_SECRET_KEY. Rotate with: python -m app.cli rotate-mfa-keys
MFA_ENCRYPTION_KEYS=
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
FRONTEND_ORIGINS=http://localhost:5173

# Optional machine translation of book titles and descriptions (admin "Find translation",
# `python -m app.cli translate-books`) when Wikidata and Wikipedia have no translation.
# Leave empty to use Wikidata and Wikipedia only. Never commit a real key.
ANTHROPIC_API_KEY=
TRANSLATION_MODEL=claude-opus-5-5

# Optional Telegram notifications: a bot made with @BotFather (token and its username without @).
# Leave empty to send emails only. Never commit a real token.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# Optional webhook mode (a public HTTPS address): Telegram posts updates to the backend instead of
# the notifier polling. 32+ random letters/digits; then: python -m app.cli telegram-webhook set
TELEGRAM_WEBHOOK_SECRET=

# Optional "Continue with Google / Apple". Callback addresses to register with the providers:
#   <API_PUBLIC_URL>/auth/oauth/google/callback and <API_PUBLIC_URL>/auth/oauth/apple/callback
# API_PUBLIC_URL defaults to APP_BASE_URL + /api/v1 (one domain behind Caddy).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
# The .p8 key's contents on one line, with \n for the line breaks.
APPLE_PRIVATE_KEY=
API_PUBLIC_URL=

# Used by: docker compose run --rm backend python -m app.cli seed
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=
