#!/usr/bin/env bash
# Runs what CI runs (except the browser tests) before anything reaches GitHub.
# Skip once with: git push --no-verify
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

# Nothing to check when the push only deletes remote branches.
pushes=0
while read -r _local_ref local_sha _remote_ref _remote_sha; do
  [[ "$local_sha" =~ ^0+$ ]] || pushes=1
done
((pushes)) || exit 0

if [[ -n "$(git status --porcelain --untracked-files=no)" ]]; then
  echo "pre-push: note: uncommitted changes are checked too, but are not part of this push." >&2
fi
exec scripts/check.sh
