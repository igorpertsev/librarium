= turbo_frame_tag Book.new do
  = form_for @book, html: { class: 'mt-4 mb-5' } do |f|
    .mb-3.col-sm-6
      = f.label :title, class: "form-label"
      = f.text_field :title, class: "form-control"
    .mb-3.col-sm-6
      = f.label :author, class: "form-label"
      = f.select :author_id, Author.all.pluck(:full_name, :id), {}, class: "form-select"
    .mb-3.col-sm-6
      = f.label :publisher, class: "form-label"
      = f.select :publisher_id, Publisher.all.pluck(:name, :id), {}, class: "form-select"
    .mb-3.col-sm-6
      = f.label :genre, class: "form-label"
      = f.select :genre_ids, Genre.all.pluck(:name, :id), {}, class: "form-select", multiple: true, size: 5
    .mb-3.col-sm-6
      = f.label :description, class: "form-label"
      = f.text_area :description, class: "form-control"
    .mb-3.col-sm-6
      = f.label :page_count, class: "form-label"
      = f.number_field :page_count, class: "form-control"
    .mb-3.col-sm-6
      = f.label :published_year, class: "form-label"
      = f.number_field :published_year, class: "form-control"
    %p
      = f.submit t('helpers.submit.save'), class: "btn btn-primary"
