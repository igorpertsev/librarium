.container
  .header
    %h3.text-5xl.mb-4= t('books.name')
    = link_to  t('books.form.new'), new_book_path, data: { turbo_frame: dom_id(Book.new)  }, class: "btn btn-primary mb-4"

  = turbo_frame_tag Book.new

  = turbo_frame_tag 'books' do
    %table.table
      %thead
        %tr
          %th #
          %th= t('books.table.title')
          %th= t('books.table.author')
          %th= t('books.table.genre')
          %th= t('books.table.publisher')
          %th= t('books.table.description')
          %th= t('books.table.published_year')
          %th= t('books.table.page_count')
          %th= t('books.table.created_at')
          %th= t('books.table.updated_at')
          %th
      %tbody#books-table-body
        = render @books
