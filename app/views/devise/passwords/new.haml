= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :post }) do |f|
  = render "devise/shared/error_messages", resource: resource
  .d-flex.flex-column.justify-content-center.align-items-center.mt-5-em
    .form-group.mb-3.w-50
      = f.label :email, class: "form-label"
      = f.email_field :email, autofocus: true, autocomplete: "email", class: "form-control"
    .mb-3.d-flex.align-items-center.justify-content-center
      = f.submit I18n.t('devise.send_instructions'), class:"btn btn-lg btn-primary rounded-pill"
    = render "devise/shared/links"
