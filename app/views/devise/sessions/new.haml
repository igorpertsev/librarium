= form_for(resource, as: resource_name, url: session_path(resource_name)) do |f|
  .d-flex.flex-column.justify-content-center.align-items-center.mt-5-em
    .form-group.mb-3.w-50
      = f.label I18n.t('devise.email'), class: "form-label"
      = f.email_field :email, autofocus: true, autocomplete: "email", class:"form-control"
    .form-group.mb-3.w-50
      = f.label I18n.t('devise.password'), class: "form-label"
      = f.password_field :password, autocomplete: "current-password", class:"form-control"
    - if devise_mapping.rememberable?
      .form-check.mb-3.w-50
        = f.check_box :remember_me, class:"form-check-input"
        = f.label I18n.t('devise.remember_me'), class:"form-check-label"
    .mb-3.d-flex.align-items-center.justify-content-center
      = f.submit I18n.t('devise.log_in'), class:"btn btn-lg btn-primary rounded-pill"
    = render "devise/shared/links"
