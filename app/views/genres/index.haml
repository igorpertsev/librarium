.container
  .header
    %h3.text-5xl.mb-4= t('genres.name')
    = link_to t('genres.form.new'), new_genre_path, data: { turbo_frame: dom_id(Genre.new)  }, class: "btn btn-primary mb-4"

  = turbo_frame_tag Genre.new

  = turbo_frame_tag 'genres' do
    %table.table
      %thead
        %tr
          %th #
          %th= t('genres.table.name')
          %th= t('genres.table.books_count')
          %th= t('genres.table.created_at')
          %th= t('genres.table.updated_at')
          %th
      %tbody#genres-table-body
        = render @genres
