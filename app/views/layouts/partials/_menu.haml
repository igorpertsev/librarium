.container-flouid
  %nav.navbar.navbar-expand-lg.bg-light.sticky-top
    .container
      %a.navbar-brand{href: library_path}
        = image_tag "logo.png", size: "100x100", alt: "Logo", class: "img-fluid"
      %ul.navbar-nav.me-auto.mb-2.mb-lg-0
        %li.nav-item.ms-4
          %a.nav-link.active{"aria-current" => "page", href: library_path}= I18n.t('menu.home')
        %li.nav-item.ms-4
          %a.nav-link.active{href: about_path}= I18n.t('menu.about')
        %li.nav-item.ms-4
          %a.nav-link.active{"aria-current" => "page", href: contact_path}= I18n.t('menu.contact')
      %form
        - if current_user
          = link_to I18n.t('menu.logout'), destroy_user_session_path, class: "btn btn-outline-primary mr-2"
          - if current_user.admin?
            %div Admin
        - else
          = link_to I18n.t('menu.login'), new_session_path(User), class: "btn btn-outline-primary mr-2"
          = link_to I18n.t('menu.register'), new_registration_path(User), class: "btn btn-outline-success"
