.container
  .header
    %h3.text-5xl.mb-4= t('publishers.name')
    = link_to t('publishers.form.new'), new_publisher_path, data: { turbo_frame: dom_id(Publisher.new)  }, class: "btn btn-primary mb-4"

  = turbo_frame_tag Publisher.new

  = turbo_frame_tag 'publishers' do
    %table.table
      %thead
        %tr
          %th #
          %th= t('publishers.table.name')
          %th= t('publishers.table.created_at')
          %th= t('publishers.table.updated_at')
          %th
      %tbody#publishers-table-body
        = render @publishers
