# Copy to backend/.env and adjust. Never commit the filled-in .env.

ENVIRONMENT=development

# Host port 5433 avoids clashing with another local PostgreSQL on 5432
# (docker-compose maps POSTGRES_PORT, default 5433, to the container's 5432).
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5433/bookstore

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
# Required in production (>= 32 chars). If empty in development, an ephemeral secret is used.
JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

REFRESH_COOKIE_NAME=refresh_token
# true in production (HTTPS). false only for local http://localhost development.
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Comma-separated exact origins allowed to call the API with cookies (no "*").
FRONTEND_ORIGINS=http://localhost:5173

# Customer emails sent by `python -m app.cli notifications` (empty SMTP_HOST = disabled).
SMTP_HOST=
SMTP_PORT=587
SMTP_STARTTLS=true
SMTP_SSL=false
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM=Little Dragon Library <no-reply@example.com>
# Public frontend URL used in email links; reminder lead time in days.
APP_BASE_URL=http://localhost:5173
DUE_SOON_DAYS=3

# Used by `python -m app.cli seed`. Pick your own strong password (>= 12 chars).
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=Administrator

# Only read by the test-suite. The database name must end with "_test".
TEST_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5433/bookstore_test
