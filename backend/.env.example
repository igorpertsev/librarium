# Copy to backend/.env and adjust. Never commit the filled-in .env.

ENVIRONMENT=development
# Logging: LOG_FORMAT is "text" or "json" (default: json in production, text otherwise).
LOG_LEVEL=INFO
LOG_FORMAT=
# Optional error reporting to Sentry or a compatible service (e.g. GlitchTip).
SENTRY_DSN=

# Host port 5433 avoids clashing with another local PostgreSQL on 5432
# (docker-compose maps POSTGRES_PORT, default 5433, to the container's 5432).
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5433/bookstore

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
# Required in production (>= 32 chars). If empty in development, an ephemeral secret is used.
JWT_SECRET_KEY=replace-with-a-long-random-secret
# Optional: keys for the two-step sign-in secrets, comma-separated, the encrypting one first
# (>= 32 random chars each). Empty => derived from JWT_SECRET_KEY. Rotate with: python -m app.cli rotate-mfa-keys
MFA_ENCRYPTION_KEYS=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

REFRESH_COOKIE_NAME=refresh_token
# true in production (HTTPS). false only for local http://localhost development.
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Comma-separated exact origins allowed to call the API with cookies (no "*").
FRONTEND_ORIGINS=http://localhost:5173
# Limits on login, registration, token refresh and password changes.
RATE_LIMIT_ENABLED=true

# Customer emails sent by `python -m app.cli notifications` (empty SMTP_HOST = disabled).
SMTP_HOST=
SMTP_PORT=587
SMTP_STARTTLS=true
SMTP_SSL=false
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM=Little Dragon Library <no-reply@example.com>
# Public frontend URL used in email links; reminder lead time in days.
APP_BASE_URL=http://localhost:5173
# Uploaded book covers (a volume at /app/media in Docker) and the upload limit in bytes.
MEDIA_DIR=media
MAX_COVER_BYTES=5242880
# Lifetime of password reset links, in minutes.
PASSWORD_RESET_EXPIRE_MINUTES=60
DUE_SOON_DAYS=3

# Used by `python -m app.cli seed`. Pick your own strong password (>= 12 chars).
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=Administrator

# Only read by the test-suite. The database name must end with "_test".
TEST_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5433/bookstore_test

# Optional Telegram notifications (bot from @BotFather): token and username without @.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# Optional notifications on readers' phones and computers (Web Push, installed app or HTTPS site).
# Keys: python -m app.cli generate-vapid-keys. Contact: mailto: or https:// address push services
# can reach you at. Never commit the private key.
WEB_PUSH_PUBLIC_KEY=
WEB_PUSH_PRIVATE_KEY=
WEB_PUSH_CONTACT=

# Optional sign in with Google / Apple (see the root .env.example for the callback URLs).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
API_PUBLIC_URL=
