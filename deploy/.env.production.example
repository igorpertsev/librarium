# Production settings for docker-compose.prod.yml.
# On the server: cp deploy/.env.production.example .env   (next to docker-compose.prod.yml)
# The filled-in .env holds secrets: never commit it (it is git-ignored).

# Public hostname. Point its DNS A record at the VM's public IP before the first start,
# otherwise Caddy cannot obtain the HTTPS certificate. No domain yet? Use <ip-with-dashes>.sslip.io,
# e.g. 203-0-113-10.sslip.io for 203.0.113.10.
DOMAIN=library.example.com
# Contact address for Let's Encrypt (certificate expiry notices).
ACME_EMAIL=you@example.com

POSTGRES_USER=librarium
POSTGRES_DB=librarium
# Generate: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
POSTGRES_PASSWORD=
# Generate: python3 -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=

ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# Only needed while running the seed command once (see deploy/README.md); remove afterwards.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
