# Production settings for docker-compose.prod.yml.
# On the server: cp deploy/.env.production.example .env   (next to docker-compose.prod.yml)
# The filled-in .env holds secrets: never commit it (it is git-ignored).

# Public hostname. Point its DNS A record at the VM's public IP before the first start,
# otherwise Caddy cannot obtain the HTTPS certificate. No domain yet? Use <ip-with-dashes>.sslip.io,
# e.g. 203-0-113-10.sslip.io for 203.0.113.10.
DOMAIN=library.example.com
# Contact address for Let's Encrypt (certificate expiry notices).
ACME_EMAIL=you@example.com

POSTGRES_USER=librarium
POSTGRES_DB=librarium
# Generate: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
POSTGRES_PASSWORD=
# Generate: python3 -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=
# Encrypts the two-step sign-in secrets, so JWT_SECRET_KEY can change without turning it off.
# Generate: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# Rotation: "new,old", then `docker compose -f docker-compose.prod.yml exec backend python -m app.cli rotate-mfa-keys`, then "new".
MFA_ENCRYPTION_KEYS=

ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# Customer emails (optional). Use your mail provider's SMTP settings; leave SMTP_HOST
# empty to disable sending. Port 587 + STARTTLS is the usual choice; for port 465 set
# SMTP_SSL=true and SMTP_STARTTLS=false.
SMTP_HOST=
SMTP_PORT=587
SMTP_STARTTLS=true
SMTP_SSL=false
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM=Little Dragon Library <library@example.com>

# Logs are JSON lines with a request id. Optional: report unhandled errors to Sentry (or a
# compatible service such as GlitchTip) by pasting the project's DSN here.
LOG_LEVEL=INFO
SENTRY_DSN=

# Book translations (optional, see deploy/README.md). "Find translation" in the admin portal
# always uses Wikidata and Wikipedia; with an Anthropic API key it also machine-translates what
# they lack. Leave empty to turn machine translation off.
ANTHROPIC_API_KEY=
TRANSLATION_MODEL=claude-opus-5-5

# Monitoring (optional, see "Monitoring and alerts" in deploy/README.md): "dead man's switch"
# URLs, e.g. from healthchecks.io. The notifier calls NOTIFIER_PING_URL every 5 minutes;
# deploy/backup.sh calls BACKUP_PING_URL after each backup (and <url>/fail if it fails).
NOTIFIER_PING_URL=
BACKUP_PING_URL=

# Only needed while running the seed command once (see deploy/README.md); remove afterwards.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
