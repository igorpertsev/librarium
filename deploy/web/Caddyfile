# DOMAIN and ACME_EMAIL come from the environment (see docker-compose.prod.yml).
# Caddy obtains and renews the TLS certificate and redirects HTTP to HTTPS.
{
	email {$ACME_EMAIL}
}

{$DOMAIN} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		# Scripts, styles and API calls only from this site. Book covers may come from any
		# HTTPS host (Open Library, image URLs entered by staff). Inline styles are needed by
		# React style attributes and the UI components; inline scripts are not allowed.
		# "?" keeps the stricter policy the API sets on its own JSON responses.
		?Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' https: data: blob:; font-src 'self' data:; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
		Cross-Origin-Opener-Policy "same-origin"
		-Server
	}

	# Link previews: bots that fetch a shared /books/<id> link (they don't run JavaScript) get
	# a small page with the book's title, description and cover; people get the app.
	@preview {
		path /books/*
		header_regexp User-Agent (?i)(bot|crawler|spider|preview|facebookexternalhit|telegram|whatsapp|slack|discord|twitter|linkedin|vkshare|skype)
	}
	handle @preview {
		rewrite * /api/v1/share{path}
		reverse_proxy backend:8000
	}

	# API: everything under /api goes to FastAPI. Docs (/docs, /openapi.json) stay private.
	handle /api/* {
		reverse_proxy backend:8000
	}

	# Single-page app: static files, unknown paths fall back to index.html.
	handle {
		root * /srv
		@hashed path /assets/*
		header @hashed Cache-Control "public, max-age=31536000, immutable"
		header ?Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}
